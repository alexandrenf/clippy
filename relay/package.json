{
  "name": "@clippy/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --config wrangler.staging.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "migrate:staging": "wrangler d1 migrations apply clippy-relay-staging --remote --config wrangler.staging.jsonc",
    "migrate:production": "wrangler d1 migrations apply clippy-relay-production --remote --config wrangler.production.jsonc"
  },
  "dependencies": {
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260809.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
