{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clippy-relay-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "vars": {
    "WORKOS_ISSUER": "https://api.workos.com/",
    "WORKOS_AUDIENCE": "client_test",
    "RELAY_ISSUER": "https://relay-staging.example.test",
    "PUBLIC_HOSTNAME": "clippy-staging.example.test",
    "ORIGIN_PORT": "3210",
    "CLOUDFLARE_ACCOUNT_ID": "account_test",
    "CLOUDFLARE_ZONE_ID": "zone_test",
    "CLOUDFLARE_API_TOKEN": "test-cloudflare-token-not-secret",
    "RELAY_TOKEN_SECRET": "test-relay-token-secret-at-least-thirty-two-bytes",
    "RELAY_SIGNING_PRIVATE_JWK": "{}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clippy-relay-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
